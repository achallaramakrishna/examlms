DATABASE_URL=postgres://examlms:examlms_password@localhost:5432/examlms
OPENAI_API_KEY=

# Base URL the browser can reach the backend at, for linking extracted
# question/option diagram images (served from backend/public/question-images)
PUBLIC_ASSET_BASE_URL=http://localhost:4000

# Where extract-scanned-questions.ts copies diagram images so the backend's
# static file server can serve them. Must resolve to the same directory the
# backend serves at PUBLIC_ASSET_BASE_URL/question-images. Resolved relative
# to vectordb/scripts/, so two levels up reaches backend/ (a sibling of
# vectordb/, matching this repo layout) — don't shorten this to one level up.
BACKEND_PUBLIC_DIR=../../backend/public/question-images
